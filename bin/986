#!/usr/bin/env bash
set -Eeuo pipefail

INSTALL_ROOT="/usr/local/lib/986-vps"

for module in common registry xray subscription system wireguard users licensing; do
  file="$INSTALL_ROOT/$module.sh"
  [[ -r "$file" ]] || { printf '986 VPS Engine: missing runtime module: %s\n' "$file" >&2; exit 1; }
  # shellcheck disable=SC1090
  source "$file"
done

usage() {
  cat <<'EOF'
986 VPS Engine

Usage:
  986                         Interactive menu
  986 status                  Product/server summary
  986 doctor                  Diagnostics
  986 system                  Detailed system information
  986 registry                Show managed services and ports
  986 license                 Early Access/license status

Xray (primary engine):
  986 xray install [stable]
  986 xray bootstrap reality --server-name HOST --target HOST:443 [--port N] [--name NAME]
  986 xray status
  986 xray doctor
  986 xray restart
  986 xray client [NAME]      Print generated VLESS REALITY URI

Client compatibility:
  986 subscription uri [NAME]
  986 subscription mihomo [NAME]  Generate Mihomo/OpenClash YAML
  986 subscription status

WireGuard (optional):
  986 wireguard install       Install and configure wg0
  986 wireguard status        Show service and peer state
  986 wireguard restart       Restart wg0 safely

Legacy local WireGuard users:
  986 user add NAME [--days N]
  986 user list
  986 user suspend NAME
  986 user resume NAME
  986 user renew NAME [DAYS]
  986 user delete NAME
  986 user config NAME

Other:
  986 version
  986 help
EOF
}

interactive_reality_bootstrap() {
  local server_name target port name
  printf '\nREALITY target selection is operator-controlled.\n'
  printf 'Use a TLS hostname/target you have evaluated for your deployment.\n\n'
  read -r -p 'Server name (SNI): ' server_name
  read -r -p 'Target (host:port): ' target
  read -r -p 'Listen port [443]: ' port
  read -r -p 'Bootstrap client name [bootstrap]: ' name
  xray_bootstrap_reality reality \
    --server-name "$server_name" \
    --target "$target" \
    --port "${port:-443}" \
    --name "${name:-bootstrap}"
}

interactive_menu() {
  while true; do
    clear 2>/dev/null || true
    printf '============================================================\n'
    printf '  986 VPS Engine  %s\n' "$PRODUCT_VERSION"
    printf '  Installation: %s\n' "$(installation_id)"
    printf '============================================================\n'
    printf '  1) Status\n'
    printf '  2) System information\n'
    printf '  3) Diagnostics\n'
    printf '  4) Install / upgrade Xray stable\n'
    printf '  5) Bootstrap VLESS REALITY + XTLS Vision\n'
    printf '  6) Xray status\n'
    printf '  7) Xray diagnostics\n'
    printf '  8) Show bootstrap VLESS URI\n'
    printf '  9) Generate Mihomo / OpenClash YAML\n'
    printf ' 10) Service / port registry\n'
    printf ' 11) Install WireGuard (optional)\n'
    printf ' 12) WireGuard status\n'
    printf ' 13) List legacy WireGuard users\n'
    printf ' 14) License status\n'
    printf '  0) Exit\n\n'
    read -r -p 'Select: ' choice
    case "$choice" in
      1) status_summary ;;
      2) system_summary ;;
      3) doctor || true ;;
      4) xray_install "$(config_value xray_channel stable)" ;;
      5) interactive_reality_bootstrap ;;
      6) xray_status ;;
      7) xray_doctor || true ;;
      8) subscription_uri ;;
      9) subscription_mihomo ;;
      10) registry_list ;;
      11) wireguard_install ;;
      12) wireguard_status || true ;;
      13) user_list ;;
      14) license_status ;;
      0) exit 0 ;;
      *) warn 'Invalid selection' ;;
    esac
    printf '\n'
    read -r -p 'Press Enter to continue...' _
  done
}

ensure_state
registry_ensure_state
load_config

case "${1:-}" in
  '') interactive_menu ;;
  status) status_summary ;;
  doctor) doctor ;;
  system) system_summary ;;
  registry) registry_list ;;
  license) license_status ;;
  version|--version|-v) printf '%s %s\n' "$PRODUCT_NAME" "$PRODUCT_VERSION" ;;
  help|--help|-h) usage ;;
  xray)
    action="${2:-}"
    case "$action" in
      install) xray_install "${3:-${XRAY_CHANNEL:-stable}}" ;;
      bootstrap)
        shift 2
        xray_bootstrap_reality "$@"
        ;;
      status) xray_status ;;
      doctor) xray_doctor ;;
      restart) xray_restart ;;
      client) xray_show_client "${3:-}" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  subscription)
    case "${2:-}" in
      uri) subscription_uri "${3:-}" ;;
      mihomo|openclash) subscription_mihomo "${3:-}" ;;
      status) subscription_status ;;
      *) usage; exit 2 ;;
    esac
    ;;
  wireguard)
    case "${2:-}" in
      install) wireguard_install ;;
      status) wireguard_status ;;
      restart) wireguard_restart ;;
      *) usage; exit 2 ;;
    esac
    ;;
  user)
    action="${2:-}"
    shift 2 || true
    case "$action" in
      add) user_add "$@" ;;
      list) user_list ;;
      suspend) user_suspend "$@" ;;
      resume) user_resume "$@" ;;
      renew) user_renew "$@" ;;
      delete) user_delete "$@" ;;
      config) user_show_config "$@" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  *) usage; exit 2 ;;
esac
